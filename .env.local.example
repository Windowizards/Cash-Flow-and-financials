# Copy this file to .env.local and fill in the values from your Supabase project.
# Dashboard > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# service_role secret (NOT the anon key) — same page, further down.
# Server-only: used by API routes for database operations.
# Never prefix this with NEXT_PUBLIC_ or it'll ship to the browser.
# Also add this to your hosting provider's environment variables for production.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret
